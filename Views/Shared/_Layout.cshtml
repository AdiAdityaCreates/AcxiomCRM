<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">AcxiomCRM</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
      @if (User.Identity?.IsAuthenticated == true) {
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Leads" asp-action="Index">Leads</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index">Opportunities</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="FollowUps" asp-action="Index">Follow-ups</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Activities" asp-action="Index">Activities</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>
        @if (User.IsInRole("Admin")) {
          <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Audit" asp-action="Index">Audit</a></li>
        }
      </ul>
      <span class="navbar-text me-3">@User.Identity.Name</span>
      <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Logout</button></form>
      } else {
      <div class="ms-auto"><a class="btn btn-outline-light btn-sm me-2" asp-controller="Account" asp-action="Login">Login</a><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a></div>
      }
    </div>
  </div>
</nav>
<main class="container-fluid px-lg-5 py-4">
  @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
  @RenderBody()
</main>
<footer class="border-top py-3 text-center text-muted small">AcxiomCRM · Customer and Sales Relationship Management</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
