@model IEnumerable<FollowUp>
@{ ViewData["Title"] = "Follow-ups"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h2">Follow-ups</h1><a class="btn btn-primary" asp-action="Create">+ Schedule Follow-up</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-4"><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var s in new[]{"Planned","Completed","Missed","Cancelled"}){<option selected="@((string?)ViewBag.Status==s)" value="@s">@s</option>}</select></div><div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div></form>
<div class="table-responsive"><table class="table table-hover bg-white"><thead><tr><th>Date</th><th>Subject</th><th>Customer</th><th>Type</th><th>Status</th><th>Update status</th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.FollowUpDate.ToString("yyyy-MM-dd") @if(x.Status=="Planned" && x.FollowUpDate.Date < DateTime.Today){<span class="badge text-bg-danger">Overdue</span>}</td><td>@x.Subject<br/><small class="text-muted">@x.Remarks</small></td><td>@x.Customer?.CustomerName</td><td>@x.FollowUpType</td><td>@x.Status</td><td><form asp-action="UpdateStatus" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@x.FollowUpId"/><select name="status" class="form-select form-select-sm">@foreach(var s in new[]{"Planned","Completed","Missed","Cancelled"}){<option selected="@(x.Status==s)">@s</option>}</select><button class="btn btn-sm btn-outline-primary">Save</button></form></td></tr>}
</tbody></table></div>
