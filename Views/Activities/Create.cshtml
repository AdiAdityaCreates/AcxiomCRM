@model Activity
@{ ViewData["Title"] = "Log Activity"; }
<h1 class="h2 mb-3">Log Activity</h1><div class="card"><div class="card-body"><form asp-action="Create" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3">
<div class="col-md-4"><label asp-for="ActivityType" class="form-label"></label><select asp-for="ActivityType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div>
<div class="col-md-8"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control"/><span asp-validation-for="Subject" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
<div class="col-md-4"><label asp-for="CustomerId" class="form-label">Customer ID (optional)</label><input asp-for="CustomerId" class="form-control"/></div>
<div class="col-md-4"><label asp-for="LeadId" class="form-label">Lead ID (optional)</label><input asp-for="LeadId" class="form-control"/></div>
<div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Planned</option><option>Completed</option><option>Cancelled</option></select></div>
</div><div class="mt-4"><button class="btn btn-primary">Save Activity</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
