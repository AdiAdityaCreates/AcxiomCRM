@model IEnumerable<Activity>
@{ ViewData["Title"] = "Activities"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h2">Activities</h1><a class="btn btn-primary" asp-action="Create">+ Log Activity</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-4"><select name="type" class="form-select"><option value="">All activity types</option>@foreach(var t in new[]{"Call","Meeting","Email","Task"}){<option selected="@((string?)ViewBag.Type==t)" value="@t">@t</option>}</select></div><div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div></form>
<div class="table-responsive"><table class="table table-hover bg-white"><thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Description</th><th>Status</th></tr></thead><tbody>
@foreach(var x in Model){<tr><td>@x.ActivityDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@x.ActivityType</td><td>@x.Subject</td><td>@x.Description</td><td>@x.Status</td></tr>}
</tbody></table></div>
